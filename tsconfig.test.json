{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "target": "es2020",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "outDir": "build-tests"
  },
  "include": [
    "tests/**/*.ts",
    "src/exercise/**/*.ts",
    "src/activities/**/*.ts",
    "src/data/**/*.ts",
    "src/settings/theme-preference.ts"
  ],
  "exclude": ["node_modules"]
}